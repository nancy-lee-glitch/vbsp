# ==============================================================================
# Vertex Bullion Savings Plan (VBSP) - Environment Variables Template
# ==============================================================================

# Node.js Server Port & Host Binding
PORT=3000
NODE_ENV=development

# Application Public Host URL (Used for API endpoints, links, and callbacks)
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Optional Gemini API Key for AVA AI Virtual Assistant (Server-side only)
# AI Studio automatically injects this at runtime from user secrets when configured.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Database Connection (Neon Serverless PostgreSQL / Vercel Postgres)
# Single connection string from your Neon console or Vercel Postgres dashboard
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
POSTGRES_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# SMTP Mail Dispatcher Configuration (Optional for Production SMTP)
MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=thriftline@yourdomain.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=thriftline@yourdomain.com
MAIL_FROM_NAME="Vertex Bullion Savings Plan"
